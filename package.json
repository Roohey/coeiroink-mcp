{
  "name": "coeiroink-mcp",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets Claude Code and Codex CLI control COEIROINK text-to-speech.",
  "bin": {
    "coeiroink-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check:version": "node scripts/check-version.mjs",
    "install:codex": "node scripts/install-codex.mjs",
    "uninstall:codex": "node scripts/uninstall-codex.mjs",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  }
}
